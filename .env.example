# Copy to .env and change the values.
POSTGRES_USER=payment
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payment_test
JWT_SECRET=change-me-to-a-long-random-string
PGADMIN_EMAIL=admin@paymenttest.com
PGADMIN_PASSWORD=change-me

# Stripe - https://dashboard.stripe.com/test/apikeys (use sk_test_... while testing)
APP_URL=http://localhost:5180
STRIPE_SECRET_KEY=sk_test_...
# Get it with: docker compose run --rm stripe-cli "stripe listen --print-secret"
STRIPE_WEBHOOK_SECRET=whsec_...

# Opn Payments (Omise) - https://dashboard.omise.co/test/keys
OMISE_SECRET_KEY=skey_test_...
# PayPal - https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
